#!/usr/bin/env bash
# devc — run any project in a podman dev container.
#
# Spins up (and reuses) a persistent container for the current directory,
# bind-mounted at /workspace, with Python 3.12, Node 22 and the Claude Code CLI.
# Anything else you need: `sudo apt-get install ...` or `pip install ...` inside —
# the container persists, so installs survive until you `devc rm`.
#
# Usage:
#   devc                 start/attach a shell in the container for $PWD
#   devc code            open VS Code attached inside the container at /workspace
#   devc claude [args]   run the Claude Code CLI inside the container
#   devc run <cmd...>    run an arbitrary command inside the container
#   devc build           (re)build the base image
#   devc stop            stop this project's container
#   devc rm              stop + remove this project's container
#   devc ls              list all devc containers
set -euo pipefail

IMAGE="devc-base:latest"

# Resolve the real login home from the passwd db, not $HOME: editors that run
# under snap/flatpak confinement (e.g. VS Code) rewrite $HOME and XDG_* to point
# inside their sandbox, where the real ~/.claude config does not live. Fall back
# to $HOME where getent is unavailable (macOS, Git Bash on Windows).
if command -v getent >/dev/null 2>&1; then
    REAL_HOME="$(getent passwd "$(id -u)" | cut -d: -f6)"
fi
[ -n "${REAL_HOME:-}" ] || REAL_HOME="$HOME"

err() { printf 'devc: %s\n' "$*" >&2; }

# Base image definition. Single source of truth; built from stdin (no context
# dir needed since there is no COPY). Edit here, then run `devc build`.
dockerfile() {
cat <<'EOF'
FROM python:3.12-bookworm

# --- system tooling (extend at runtime with: sudo apt-get install ...) ---
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl git ca-certificates sudo less vim nano \
        build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*

# --- Node.js (also required by the Claude Code CLI) ---
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# --- Claude Code CLI ---
RUN npm install -g @anthropic-ai/claude-code

# --- non-root user with passwordless sudo + serial access (dialout) ---
ARG USERNAME=dev
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME \
    && usermod -aG dialout $USERNAME \
    && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

USER $USERNAME
WORKDIR /workspace
CMD ["/bin/bash"]
EOF
}

build_image() {
    err "building $IMAGE ..."
    dockerfile | podman build -t "$IMAGE" -f - .
}

ensure_image() {
    podman image exists "$IMAGE" || build_image
}

# --- shared VS Code server cache ---------------------------------------------
# Every devc container mounts the named volume devc-vscode-cache at
# /opt/vscode-cache. It holds pristine, unpacked VS Code Server builds (bin/<commit>)
# a snapshot of installed extensions and a shared extensionsCache, so a new container doesn't pay for streaming
# ~200 MB of server into itself and re-copying/re-downloading extensions: before
# VS Code attaches we copy the matching server build into ~/.vscode-server/bin
# locally, and VS Code finds it already installed. The cache is filled from the
# tarball VS Code itself downloaded on this host (/tmp/vsch-$USER/serverCache).
# Builds unused for 30 days are pruned. Containers created before this volume
# existed simply skip the whole thing.
VSCODE_SEED='
commit=$1; have_tar=$2
c=/opt/vscode-cache
[ -d "$c" ] || exit 0
[ -w "$c" ] || sudo -n chown "$(id -u):$(id -g)" "$c" 2>/dev/null || exit 0
mkdir -p "$c/bin" "$c/extensionsCache" "$HOME/.vscode-server/bin"
# a build counts only if complete (product.json); drop leftovers of a bad copy
[ -f "$c/bin/$commit/product.json" ] || rm -rf "$c/bin/$commit"
if [ ! -d "$c/bin/$commit" ] && [ "$have_tar" = 1 ]; then
    # the tarball holds a single top-level dir (vscode-server-linux-<arch>/)
    t="$c/bin/.$commit.$$"
    if mkdir -p "$t" && tar --no-same-owner -xz -C "$t"; then
        s=$(find "$t" -name product.json -maxdepth 2 | head -n1)
        [ -n "$s" ] && mv -T "$(dirname "$s")" "$c/bin/$commit" 2>/dev/null
    fi
    rm -rf "$t"
fi
b="$HOME/.vscode-server/bin/$commit"
if [ -f "$c/bin/$commit/product.json" ]; then
    touch "$c/bin/$commit"
    [ -f "$b/product.json" ] || rm -rf "$b"
    if [ ! -d "$b" ]; then
        cp -a "$c/bin/$commit" "$b.$$" && mv -T "$b.$$" "$b" 2>/dev/null
        rm -rf "$b.$$"
    fi
fi
# installed extensions: seed an empty container from the shared snapshot, or
# refresh the snapshot from a container that already has them installed
x="$HOME/.vscode-server/extensions"
if [ -f "$x/extensions.json" ]; then
    if ! cmp -s "$x/extensions.json" "$c/extensions/extensions.json"; then
        t="$c/.ext.$$"
        if cp -a "$x" "$t"; then
            rm -rf "$c/.ext.old"
            [ ! -d "$c/extensions" ] || mv -T "$c/extensions" "$c/.ext.old"
            mv -T "$t" "$c/extensions"
        fi
        rm -rf "$t" "$c/.ext.old"
    fi
elif [ ! -e "$x" ] && [ -f "$c/extensions/extensions.json" ]; then
    cp -a "$c/extensions" "$x.$$" && mv -T "$x.$$" "$x" 2>/dev/null
    rm -rf "$x.$$"
fi
e="$HOME/.vscode-server/extensionsCache"
[ -e "$e" ] || ln -s "$c/extensionsCache" "$e"
find "$c/bin" -mindepth 1 -maxdepth 1 -mtime +30 -exec rm -rf {} + 2>/dev/null
exit 0
'

# seed_vscode_server CODE_BIN CONTAINER PODMAN_CMD... — best effort, never fails.
seed_vscode_server() {
    local code_bin="$1" ctr="$2"; shift 2
    local commit probe arch tar
    commit="$("$code_bin" --version 2>/dev/null | sed -n 2p)" || return 0
    [ -n "$commit" ] || return 0
    probe="$("$@" exec "$ctr" sh -c \
        'uname -m; [ -d /opt/vscode-cache ] && echo vol; [ -f "/opt/vscode-cache/bin/$1/product.json" ] && echo cached; true' \
        sh "$commit" 2>/dev/null)" || return 0
    case "$probe" in *vol*) ;; *) return 0 ;; esac
    case "$(printf '%s' "$probe" | head -n1)" in
        x86_64) arch=x64 ;; aarch64|arm64) arch=arm64 ;; armv7l) arch=armhf ;; *) return 0 ;;
    esac
    tar="/tmp/vsch-$(id -un)/serverCache/$commit/vscode-server-linux-$arch.tar.gz"
    case "$probe" in
        *cached*) "$@" exec "$ctr" sh -c "$VSCODE_SEED" sh "$commit" 0 >/dev/null 2>&1 || true ;;
        *) if [ -f "$tar" ]; then
               "$@" exec -i "$ctr" sh -c "$VSCODE_SEED" sh "$commit" 1 <"$tar" >/dev/null 2>&1 || true
           else
               "$@" exec "$ctr" sh -c "$VSCODE_SEED" sh "$commit" 0 >/dev/null 2>&1 || true
           fi ;;
    esac
}

# Stable container name derived from the project path. md5sum on Linux, `md5`
# on macOS, cksum as a last resort — just needs to be stable per path.
project_dir="$(pwd)"
base="$(basename "$project_dir" | tr -c 'a-zA-Z0-9_.-' '-')"
if command -v md5sum >/dev/null 2>&1; then
    hash="$(printf '%s' "$project_dir" | md5sum | cut -c1-8)"
elif command -v md5 >/dev/null 2>&1; then
    hash="$(printf '%s' "$project_dir" | md5 -q | cut -c1-8)"
else
    hash="$(printf '%s' "$project_dir" | cksum | tr -d ' ' | cut -c1-8)"
fi
CONTAINER="devc-${base}-${hash}"

# Create the container if it doesn't exist yet, then make sure it's running.
ensure_container() {
    ensure_image
    if ! podman container exists "$CONTAINER"; then
        err "creating container $CONTAINER for $project_dir"
        local mounts=()
        # Persist Claude Code auth/config across containers if present on host.
        [ -d "$REAL_HOME/.claude" ]      && mounts+=(-v "$REAL_HOME/.claude:/home/dev/.claude:Z")
        [ -f "$REAL_HOME/.claude.json" ] && mounts+=(-v "$REAL_HOME/.claude.json:/home/dev/.claude.json:Z")
        [ -f "$REAL_HOME/.gitconfig" ]   && mounts+=(-v "$REAL_HOME/.gitconfig:/home/dev/.gitconfig:ro,Z")
        # Host networking only on native Linux (any port the app binds is
        # reachable from the host). On podman-machine (macOS/Windows) the host is
        # a VM, so publish ports with DEVC_ARGS="-p 5000:5000" or let VS Code's
        # attach auto-forward them instead.
        local net=()
        [ "$(uname -s)" = "Linux" ] && net=(--network host)
        # Extra podman flags applied at create time, e.g. to expose a device or
        # publish a port:  DEVC_ARGS="--device=/dev/ttyACM0" devc
        # shellcheck disable=SC2206
        local extra=(${DEVC_ARGS:-})
        # Map the host user onto the image's `dev` user (uid 1000) so bind-mounted
        # files (the project at /workspace and the ~/.claude etc. below) are owned
        # by dev inside and stay owned by you on the host. Plain `keep-id` would
        # map your host uid to the SAME uid inside, which only lines up if your
        # host uid is 1000 — on servers where it isn't (e.g. 1001), dev (1000)
        # can't read your mounted ~/.claude (mode 700) or write /workspace.
        # keep-id:uid=1000 collapses to plain keep-id when your host uid is 1000.
        podman create \
            --name "$CONTAINER" \
            --hostname "$base" \
            --userns=keep-id:uid=1000,gid=1000 \
            "${net[@]}" \
            -v "$project_dir:/workspace:Z" \
            -v devc-vscode-cache:/opt/vscode-cache \
            -w /workspace \
            -e PYTHONUNBUFFERED=1 \
            "${mounts[@]}" \
            "${extra[@]}" \
            -it "$IMAGE" >/dev/null
    fi
    if [ "$(podman inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" != "true" ]; then
        podman start "$CONTAINER" >/dev/null
    fi
}

cmd="${1:-shell}"
case "$cmd" in
    build|rebuild)
        build_image
        ;;
    ls|list)
        podman ps -a --filter "name=^devc-" \
            --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'
        ;;
    stop)
        podman stop "$CONTAINER" >/dev/null && err "stopped $CONTAINER" || err "not running"
        ;;
    rm|remove)
        podman rm -f "$CONTAINER" >/dev/null && err "removed $CONTAINER" || err "no such container"
        ;;
    code|vscode)
        ensure_container
        seed_vscode_server code "$CONTAINER" podman
        # Open VS Code attached inside the running container. The Dev Containers
        # extension addresses it via remote authority attached-container+<hexname>.
        hex="$(printf '%s' "$CONTAINER" | od -An -tx1 | tr -d ' \n')"
        exec code --folder-uri "vscode-remote://attached-container+${hex}/workspace"
        ;;
    claude)
        shift
        ensure_container
        exec podman exec -it "$CONTAINER" claude "$@"
        ;;
    run|exec)
        shift
        [ "$#" -gt 0 ] || { err "run: need a command"; exit 1; }
        ensure_container
        exec podman exec -it "$CONTAINER" "$@"
        ;;
    shell|sh|bash)
        ensure_container
        exec podman exec -it "$CONTAINER" bash
        ;;
    -h|--help|help)
        sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        err "unknown command: $cmd (try: devc help)"
        exit 1
        ;;
esac
